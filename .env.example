# Create an API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the default model slug from https://openrouter.ai/models
OPENROUTER_MODEL=openrouter/free

# Local proxy settings (used by server.py)
# Generate a random token, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PROXY_API_KEY=
PROXY_HOST=127.0.0.1
PROXY_PORT=8000
# Optional comma-separated origins for local browser apps (e.g. http://localhost:3000)
PROXY_CORS_ORIGINS=

# Charge alerts: macOS desktop notifications are enabled by default (set false to disable)
NOTIFY_MACOS=true
# Optional webhook URL (Discord, Slack, ntfy.sh, etc.) to receive alerts on any non-zero charge
ALERT_WEBHOOK_URL=
